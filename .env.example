# Server/local tooling only. Never expose this file through Vite.
PROJECT_NAME=portablekiosk
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_NAME=postgres
DATABASE_PASSWORD=
# Optional PEM CA file if the database certificate needs an additional trusted root.
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
PORT=3001
# Server defaults to localhost for local development; use 0.0.0.0 inside Docker.
HOST=127.0.0.1
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUST_PROXY=0
# Optional on first bootstrap; generated values are saved privately when absent.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
